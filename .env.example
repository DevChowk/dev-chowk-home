# Copy to .env.local — never commit .env.local.

# Public site URL, used for metadata, sitemap and robots.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Contact form (lead delivery by email) --------------------------------
# Get a key at https://resend.com/api-keys. Without it the form shows an
# honest "not configured" error instead of pretending the message was sent.
RESEND_API_KEY=

# Where leads land. Defaults to the site contact email when unset.
LEAD_TO_EMAIL=vaibhavr325@gmail.com

# Verified sender. Until you verify a domain in Resend, keep the default:
# onboarding@resend.dev can only deliver to the address that owns the Resend
# account, so sign up to Resend with the LEAD_TO_EMAIL address above.
LEAD_FROM_EMAIL="Dev Chowk <onboarding@resend.dev>"

# Salt for hashing submitter IPs in the rate limiter. Any long random string.
LEAD_IP_HASH_SECRET=
